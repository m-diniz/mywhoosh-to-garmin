# Caminho: MyWhoosh -> intervals.icu (conexão oficial) -> esta ferramenta -> Garmin Connect

# intervals.icu: Settings -> Developer Settings -> Athlete ID.
# A chave de API NÃO vai aqui:  venv\Scripts\python.exe main.py --setup
INTERVALS_ATHLETE_ID=i000000
# Só atividades cuja origem contém este texto (ALL = todas). Confira com: main.py --list
INTERVALS_SOURCE=MYWHOOSH

# Garmin: não há usuário/senha aqui. Rode uma vez
#   venv\Scripts\python.exe scripts\login_garmin.py
# que salva só o token. Pasta do token (opcional):
# GARMIN_TOKENSTORE=~/.garminconnect-mywhoosh

# Opcional: quantas atividades recentes olhar e a idade máxima (dias)
# SYNC_LIMIT=20
# SYNC_MAX_AGE_DAYS=14

# Optional: Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
